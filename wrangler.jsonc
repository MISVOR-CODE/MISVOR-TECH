{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker name in the Cloudflare dashboard (Workers & Pages > your Worker). The self-reference
  // binding below must use the SAME name, otherwise deploy fails with "Service binding 'WORKER_SELF_REFERENCE'
  // references Worker ... which was not found".
  "name": "misvor-tech",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-13",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "misvor-tech"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  }
}
