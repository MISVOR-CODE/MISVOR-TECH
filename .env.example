# Copy to .env for local development. Never commit real values.
# On Vercel, set these in Project Settings > Environment Variables instead.

# --- Database -------------------------------------------------------------
# Local: matches docker-compose.yml (run `docker compose up -d` first).
# Hosted Postgres (Neon, Supabase, Vercel Marketplace): use the POOLED url here.
DATABASE_URL="postgresql://ogsp:ogsp@localhost:5432/ogsp_news"
# Optional. Direct (non pooled) url, used only to run migrations at build time.
# Leave empty if your DATABASE_URL is already a direct connection.
DIRECT_URL=""

# --- Auth.js --------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Public origin of the site. Inlined at BUILD time (also used in email/push links).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Needed when self-hosting behind a proxy (Docker). Vercel does not need it.
# AUTH_TRUST_HOST="true"

# OAuth (optional, leave empty to disable the button's provider)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID=""

# --- Web Push -------------------------------------------------------------
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"
# Same value as VAPID_PUBLIC_KEY. Inlined at BUILD time.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# --- Email (Resend) -------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="news@example.com"

# --- n8n ------------------------------------------------------------------
# Shared HMAC secret for the inbound webhook. Generate with: openssl rand -hex 32
N8N_WEBHOOK_SECRET=""

# --- Images ---------------------------------------------------------------
# Comma separated hosts next/image may optimize, e.g. "images.example.com,*.cdn.example.com".
# Unset means ANY https host is allowed, which lets others use your image optimizer.
IMAGE_REMOTE_HOSTS=""

# --- Seeding (only for `npm run seed` against a non-local database) --------
# SEED_ADMIN_EMAIL="you@example.com"
# SEED_ADMIN_PASSWORD=""
# SEED_SAMPLE_ARTICLES="1"

# --- Vercel build ---------------------------------------------------------
# Production deploys run `prisma migrate deploy` automatically.
# RUN_MIGRATIONS=1 forces it on other environments, RUN_MIGRATIONS=0 skips it.

# Contact form: where website enquiries are delivered (needs RESEND_API_KEY and EMAIL_FROM too)
CONTACT_TO_EMAIL=
